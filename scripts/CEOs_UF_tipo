
pacman::p_load(dplyr,
               purrr,
               tidyverse,
               readxl,
               rio,
               here)

dados_CEO <- import(here("dados", "CEO 03_2026.xlsx"))

# Excluir filas da soma

dados_CEO <- dados_CEO[-(1036:1038), ]

dados_CEO <- dados_CEO %>% 
  rename(SG_UF = UF)

nrow(dados_CEO )

mapa_regiao <- tibble::tribble(
  ~SG_UF, ~regiao,
  "AC", "Norte", "AP", "Norte", "AM", "Norte", "PA", "Norte", "RO", "Norte", "RR", "Norte", "TO", "Norte",
  "AL", "Nordeste", "BA", "Nordeste", "CE", "Nordeste", "MA", "Nordeste", "PB", "Nordeste", 
  "PE", "Nordeste", "PI", "Nordeste", "RN", "Nordeste", "SE", "Nordeste",
  "DF", "Centro-Oeste", "GO", "Centro-Oeste", "MT", "Centro-Oeste", "MS", "Centro-Oeste",
  "ES", "Sudeste", "MG", "Sudeste", "RJ", "Sudeste", "SP", "Sudeste",
  "PR", "Sul", "RS", "Sul", "SC", "Sul"
)

dados_CEO <- dados_CEO %>%
  left_join(mapa_regiao, by = "SG_UF")

dados_CEO_UF <- dados_CEO %>% 
  group_by(SG_UF) %>%  
  summarise(
    n = n(),
    CEOS_PAGOS = sum(`CEOS PAGOS`, na.rm = TRUE),
    TIPO1 = sum(`TIPO 1`, na.rm = TRUE),
    TIPO2 = sum(TIPO2, na.rm = TRUE),
    TIPO3 = sum(TIPO3, na.rm = TRUE),
    RCPD = sum(RCPD, na.rm = TRUE)
  ) %>% 
  mutate(prop = n / sum(n)) %>% 
  arrange(desc(prop))

dados_CEO_UF <- dados_CEO_UF %>%
  left_join(mapa_regiao, by = "SG_UF")


dados_long <- dados_CEO_UF %>%
  pivot_longer(
    cols = c(TIPO1, TIPO2, TIPO3),
    names_to = "tipo",
    values_to = "valor"
  )


CEO_UF <- ggplot(dados_long, aes(x = reorder(SG_UF, -CEOS_PAGOS), y = valor, fill = tipo)) +
  geom_col(width = 0.6, alpha = 0.8) +
  
  scale_fill_manual(
    values = c(
      "TIPO1"  = "#1A3D64",
      "TIPO2" = "#3E5F8A",
      "TIPO3"= "#728FB0"),
    labels = c(
  "TIPO1" = "Tipo 1",
  "TIPO2" = "Tipo 2",
  "TIPO3" = "Tipo 3"),
  name = "Tipo de CEO"
  ) +
  
  labs(
    x = "Unidade Federativa",
    y = "",
    fill = "Tipo de CEO"
  ) +
  
  theme_minimal(base_size = 14) +
  theme(
    legend.position = "bottom",
    axis.text.x = element_text(face = "bold", size = 12),
    panel.background = element_rect(fill = "transparent", color = NA),
    plot.background  = element_rect(fill = "transparent", color = NA),
    axis.title.y = element_blank(),
    axis.text.y  = element_blank(),
    axis.ticks.y = element_blank()
  ) +
  geom_text(
    data = dados_CEO_UF,
    aes(x = reorder(SG_UF, -CEOS_PAGOS), y = CEOS_PAGOS, label = CEOS_PAGOS),
    inherit.aes = FALSE,
    vjust = -0.5,
    size = 5
  ) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.1)))


print(CEO_UF)

ggsave(here("output", "CEO_UF.png"), CEO_UF,
       bg = "transparent",
       width = 14,
       height = 5,
       dpi = 300)


dados_CEO %>% group_by(regiao) %>%  summarise(n=sum(`CEOS PAGOS`)) %>% 
  mutate(prop = n/sum(n) * 100) %>% arrange(desc(prop))

rcpd <- sum(dados_CEO$RCPD)

repasse_ceo <- sum(dados_CEO$TOTAL)
print(repasse_ceo)
